# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Telegram: crea il bot con @BotFather, poi prendi il tuo chat id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# eBay (developer.ebay.com > Application Keys, ambiente Production) - opzionale
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Regole di allerta
DROP_PCT=0.6            # avvisa se il prezzo e' sotto del 60% rispetto al riferimento
ZERO_THRESHOLD=0.5      # sotto questa cifra (EUR) = "prezzo zero"
MIN_REF_PRICE=5         # ignora i cali su prodotti che valgono meno di 5 EUR
HISTORY_SIZE=20
LOOP_MINUTES=15
